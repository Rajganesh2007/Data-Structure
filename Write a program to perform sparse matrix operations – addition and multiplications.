#include<stdio.h>
#define MAX 20

int main()
{
    int i, j, k;
    int a[MAX][MAX], b[MAX][MAX], c[MAX][MAX];
    int r1, r2, c1, c2;

    printf("Enter the rows and columns of Matrix A: ");
    scanf("%d%d", &r1, &c1);

    printf("Enter the rows and columns of Matrix B: ");
    scanf("%d%d", &r2, &c2);

    printf("Matrix A:\n");
    for(i = 0; i < r1; i++)
        for(j = 0; j < c1; j++)
            scanf("%d", &a[i][j]);

    printf("Matrix B:\n");
    for(i = 0; i < r2; i++)
        for(j = 0; j < c2; j++)
            scanf("%d", &b[i][j]);

    printf("Compact form of Matrix A:\n");
    k = 0;
    for(i = 0; i < r1; i++)
        for(j = 0; j < c1; j++)
            if(a[i][j] != 0)
                k++;

    printf("%d %d %d\n", r1, c1, k);

    for(i = 0; i < r1; i++)
        for(j = 0; j < c1; j++)
            if(a[i][j] != 0)
                printf("%d %d %d\n", i, j, a[i][j]);

    printf("Compact form of Matrix B:\n");
    k = 0;
    for(i = 0; i < r2; i++)
        for(j = 0; j < c2; j++)
            if(b[i][j] != 0)
                k++;

    printf("%d %d %d\n", r2, c2, k);

    for(i = 0; i < r2; i++)
        for(j = 0; j < c2; j++)
            if(b[i][j] != 0)
                printf("%d %d %d\n", i, j, b[i][j]);

    printf("Addition of Matrix A + B:\n");
    if(r1 == r2 && c1 == c2)
    {
        for(i = 0; i < r1; i++)
        {
            for(j = 0; j < c1; j++)
            {
                c[i][j] = a[i][j] + b[i][j];
                printf("%d ", c[i][j]);
            }
            printf("\n");
        }
    }
    else
        printf("Addition is not possible\n");

    printf("Multiplication of Matrix A * B:\n");
    if(c1 == r2)
    {
        for(i = 0; i < r1; i++)
        {
            for(j = 0; j < c2; j++)
            {
                c[i][j] = 0;
                for(k = 0; k < c1; k++)
                    c[i][j] += a[i][k] * b[k][j];
            }
        }

        for(i = 0; i < r1; i++)
        {
            for(j = 0; j < c2; j++)
                printf("%d ", c[i][j]);
            printf("\n");
        }
    }
    else
        printf("Multiplication is not possible\n");

    return 0;
}
