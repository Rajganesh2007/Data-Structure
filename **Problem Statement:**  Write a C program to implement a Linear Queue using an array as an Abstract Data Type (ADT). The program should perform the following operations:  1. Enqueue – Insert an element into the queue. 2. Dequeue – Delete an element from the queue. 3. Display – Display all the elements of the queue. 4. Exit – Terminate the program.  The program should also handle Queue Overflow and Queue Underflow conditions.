#include<stdio.h>
#define MAX 20

int q[MAX];
int front=-1,rear=-1;
void enqueue()
{
    int x;
    if(rear== MAX-1)
    {
        printf("Queue Overflow");
        return;
    }
    printf("Enter the element : ");
    scanf("%d",&x);
    if(front==-1)
        front=0;
    rear++;
    q[rear]=x;
}
void dequeue()
{
    if(front==-1)
    {
        printf("Queue Underflow");
        return;
    }
    printf("Deleting the element : %d ",q[front]);
    if(front==rear)
        front = rear -1;
    else
        front++;
}

void display()
{
    int i;
    if(front==-1)
    {
        printf("Queue is an Empty");
        return;
    }
    for(i=front ; i<=rear ; i++)
        printf("%d",q[i]);
    printf("\n");
}
int main()
{
    int ch;

    do{
        printf("1.Enqueue\n");
        printf("2.Dequeue\n");
        printf("3.Display\n");
        printf("4.Exit\n");
        printf("Enter the choice : ");
        scanf("%d",&ch);

        switch(ch)
            {
                case 1:enqueue();break;
                case 2:dequeue();break;
                case 3:display();break;
                case 4:break;
                default : printf("Invalid choice");
            }
    }while(ch != 4);
    return 0;
}
